[Unit]
Description=IIoT Edge Application
After=network.target

[Service]
Type=simple
ExecStart=/opt/edge-app/edge-app
WorkingDirectory=/opt/edge-app
Restart=always
RestartSec=2
User=edge
Group=edge
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/edge-app /var/lib/edge-app

[Install]
WantedBy=multi-user.target
