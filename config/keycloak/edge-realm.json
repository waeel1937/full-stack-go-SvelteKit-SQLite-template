{
  "realm": "edge",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {"name": "admin", "description": "Full access"},
      {"name": "operator", "description": "Read-only access"}
    ]
  },
  "clients": [
    {
      "clientId": "edge-frontend",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:8080"],
      "standardFlowEnabled": true,
      "protocolMappers": [{
        "name": "realm-roles",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-realm-role-mapper",
        "config": {
          "claim.name": "roles",
          "jsonType.label": "String",
          "multivalued": "true",
          "id.token.claim": "true",
          "access.token.claim": "true",
          "userinfo.token.claim": "true"
        }
      }]
    },
    {
      "clientId": "edge-backend",
      "enabled": true,
      "publicClient": false,
      "secret": "edge-backend-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@edge.local",
      "firstName": "Admin",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "admin", "temporary": false}],
      "realmRoles": ["default-roles-edge", "admin"]
    },
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "email": "operator@edge.local",
      "firstName": "Operator",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "operator", "temporary": false}],
      "realmRoles": ["default-roles-edge", "operator"]
    }
  ]
}
