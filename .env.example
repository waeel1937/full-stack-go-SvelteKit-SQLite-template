# Copy this file to .env and adjust values before running docker compose.
# .env is gitignored — never commit real credentials.

# ── Keycloak admin bootstrap ──────────────────────────────────────────────────
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=admin

# ── Go backend ────────────────────────────────────────────────────────────────
# Internal Keycloak URL (used by backend to fetch JWT public keys)
KEYCLOAK_URL=http://keycloak:8180
KEYCLOAK_REALM=edge

# Allowed browser origin for CORS — set to exact frontend URL in production
CORS_ORIGIN=http://localhost:3000

# Optional: enable cloud sync by setting a real endpoint
CLOUD_SYNC_ENDPOINT=

# ── SvelteKit frontend ────────────────────────────────────────────────────────
# These URLs are sent to the browser — they must be reachable from the user's machine
PUBLIC_BACKEND_URL=http://localhost:8080
PUBLIC_KC_URL=http://localhost:8180
PUBLIC_KC_REALM=edge
PUBLIC_KC_CLIENT=edge-frontend

# ── Production / Traefik (compose.prod.yml only) ─────────────────────────────
# DOMAIN=edge.example.com
# ACME_EMAIL=admin@example.com
